# Server-side only. Keep actual values in your shell or an ignored .env file.
NEBIUS_API_KEY=YOUR_TOKEN_FACTORY_KEY
TAVILY_API_KEY=YOUR_TAVILY_KEY
NEBIUS_PROJECT_ID=YOUR_AI_CLOUD_PROJECT
NEBIUS_SUBNET_ID=YOUR_SUBNET
# Optional locally; required for public hosting.
# PUBLIC_DEPLOYMENT=true
# HOST_ACCESS_CODE=USE_A_LONG_RANDOM_HOST_CODE
# SESSION_SECRET=USE_AT_LEAST_32_RANDOM_CHARACTERS
# GAME_DATA_DIR=/absolute/path/to/private/game-data
